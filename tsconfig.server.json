{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": ".", "outDir": "dist-server", "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "shared/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
